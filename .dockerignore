# Secrets — never bake into the image
.env
.env.*
*.pem
*.key

# Frontend is built and served separately (Expo), not part of the backend image
frontend
node_modules

# Local caches, state, and build artifacts (cache volume is mounted at runtime)
.cache
.git
.gitignore
.pytest_cache
__pycache__
*.pyc
*.db
*.db-journal
gtin_cache.db

# Runtime uploads are volume-mounted
uploads

# Docs/IDE noise
*.md
.vscode
.idea
.zcode
