PRAMAN_SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///./praman.db
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost/praman
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://127.0.0.1:8000
# Groq LLM API Key (primary Legal Metrology chatbot provider; OpenAI-compatible endpoint)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
# Gemini LLM API Key (optional secondary provider for chatbot generation & gazette enrichment)
GEMINI_API_KEY=your-gemini-api-key-here
# Environment (development | production)
ENVIRONMENT=development
